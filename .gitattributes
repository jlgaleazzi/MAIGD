# Text files are stored as UTF-8 with LF line endings, so files written on Windows
# (PowerShell, Unity) and on the DGX Spark (Linux) stay identical.
* text=auto eol=lf
*.md   text eol=lf
*.json text eol=lf
*.cs   text eol=lf diff=csharp
*.py   text eol=lf diff=python
*.sh   text eol=lf
*.svg  text eol=lf

# Unity YAML: let Unity's merge tool handle it, and keep it out of text diffs' noise
*.unity  text eol=lf merge=unityyamlmerge linguist-generated
*.prefab text eol=lf merge=unityyamlmerge linguist-generated
*.asset  text eol=lf merge=unityyamlmerge linguist-generated
*.meta   text eol=lf linguist-generated

# Binary assets
*.pdf  binary
*.png  binary
*.jpg  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
